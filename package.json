{
  "name": "piq",
  "version": "1.1.7",
  "description": "Simple cross-platform image browser.",
  "homepage": "https://github.com/slebetman/piq",
  "main": "src/index.mjs",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "rebuild": "electron-rebuild",
    "build-mac": "electron-builder --mac",
    "build-deb": "electron-builder --linux deb --x64",
    "build-win": "electron-builder --win --x64",
    "dist": "electron-builder ",
    "docker-dist": "SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm install && npm run rebuild && npm run build-win"
  },
  "author": "Adly Abdullah <slebetman@gmail.com>, Alex Woon<alexw005>",
  "license": "BSD-2-Clause",
  "build": {
    "electronLanguages": [
      "en-US"
    ],
    "fileAssociations": [
      {
        "ext": "jpg",
        "name": "JPEG",
        "role": "Viewer"
      },
      {
        "ext": "jpeg",
        "name": "JPEG",
        "role": "Viewer"
      },
      {
        "ext": "png",
        "name": "PNG",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "WebP",
        "role": "Viewer"
      },
      {
        "ext": "avif",
        "name": "AVIF",
        "role": "Viewer"
      },
      {
        "ext": "*",
        "name": "Anything",
        "role": "Viewer"
      }
    ],
    "linux": {
      "category": "Graphics",
      "asar": true,
      "asarUnpack": [
        "**/node_modules/sharp/**/*",
        "**/node_modules/@img/**/*"
      ]
    },
    "win": {
      "asar": true,
      "asarUnpack": [
        "**/node_modules/sharp/**/*",
        "**/node_modules/@img/**/*"
      ],
      "target": "nsis"
    },
    "dmg": {
      "background": "icons/bg.tiff"
    }
  },
  "devDependencies": {
    "electron": "32.1.0",
    "electron-builder": "25.0.5",
    "electron-rebuild": "3.2.9"
  },
  "dependencies": {
    "open": "10.1.0",
    "sharp": "^0.33.5",
    "trash": "9.0.0",
    "xdg-portable": "10.6.0"
  }
}
